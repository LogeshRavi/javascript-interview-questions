Sort an array without using sort()

function bubbleSort(arr) {
  const result = [...arr];

  for (let i = 0; i < result.length; i++) {
    for (let j = 0; j < result.length - i - 1; j++) {
      if (result[j] > result[j + 1]) {
        [result[j], result[j + 1]] =
          [result[j + 1], result[j]];
      }
    }
  }

  return result;
}

console.log(bubbleSort([5, 2, 8, 1, 3]));
// [1, 2, 3, 5, 8]


