function maxOccurring(arr) {
  const count = {};
  let maxElement = arr[0];
  let maxCount = 0;

  for (const num of arr) {
    count[num] = (count[num] || 0) + 1;

    if (count[num] > maxCount) {
      maxCount = count[num];
      maxElement = num;
    }
  }

  return maxElement;
}

