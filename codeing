function compressString(str) {
  if (str.length === 0) return "";

  let resultStr = "";
  let count = 1;

  for (let i = 1; i < str.length; i++) {
    if (str[i] === str[i - 1]) {
      count++;
    } else {
      resultStr += str[i - 1] + count;
      count = 1;
    }
  }

  // Append the final group
  resultStr += str[str.length - 1] + count;  ------------- XXXXXXXXXXXXXXXXXXXXXXXX

  return resultStr;
}

console.log(compressString("aaabbc")); // "a3b2c1"
console.log(compressString("abcd"));   // "a1b1c1d1"
console.log(compressString("aaaaa"));  // "a5"
console.log(compressString(""));       // ""
console.log(compressString("a"));      // "a1"

