Find the first non-repeating character


function firstNonRepeating(str) {
  const count = {};

  for (const char of str) {
    count[char] = (count[char] || 0) + 1;
  }

  for (const char of str) {
    if (count[char] === 1) {
      return char;
    }
  }

  return null;
}

console.log(firstNonRepeating("aabbcdd"));
// "c"


