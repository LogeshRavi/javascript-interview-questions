function majorityElement(nums) {
  let candidate = null;
  let count = 0;

  for (const ele of nums) {
    if (count === 0) {
      candidate = ele;
    }

    if (ele === candidate) {
      count++;
    } else {
      count--;
    }
  }

  return candidate;
}


